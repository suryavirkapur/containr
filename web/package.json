{
  "name": "containr-web",
  "version": "0.1.15-alpha",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm exec vite",
    "build": "pnpm exec vite build",
    "preview": "pnpm exec vite preview",
    "generate:schema": "cd .. && cargo run --bin openapi --features openapi-only 2>/dev/null > web/src/api/openapi.json",
    "generate:client": "pnpm dlx --package=openapi-typescript@7.13.0 --package=typescript@5.9.3 openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "generate": "pnpm run generate:schema && pnpm run generate:client",
    "smoke:ui": "node scripts/ui-smoke.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "geist": "^1.7.2",
    "lucide-solid": "^1.52.0",
    "openapi-fetch": "^0.17.0",
    "solid-js": "^1.9.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.3"
  }
}
